{
  "name": "visual-html-editor",
  "displayName": "Visual HTML Editor",
  "description": "Visually edit rendered HTML files directly in VS Code and press Ctrl+S to save changes back to source code.",
  "version": "0.0.1",
  "publisher": "hao-ngo",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/hao-ngo/vscode-visual-html-editor"
  },
  "scripts": {
    "build": "bun build src/extension.ts --outdir dist --target node --external vscode",
    "test": "bun test",
    "package": "bun run build && npx @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.75.0",
    "bun-types": "latest",
    "typescript": "^5.0.0"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:visual-html-editor.open"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "visual-html-editor.open",
        "title": "Visual HTML Editor: Open Visual Editor",
        "category": "HTML"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "visual-html-editor.open",
          "when": "resourceExtname == .html",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "visual-html-editor.open",
          "when": "resourceExtname == .html",
          "group": "navigation"
        }
      ]
    }
  }
}
