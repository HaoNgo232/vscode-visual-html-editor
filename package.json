{
  "name": "visual-html-live-editor",
  "displayName": "Visual HTML Live Editor",
  "description": "Visually edit rendered HTML files directly in VS Code and press Ctrl+S to save changes back to source code.",
  "version": "0.0.7",
  "publisher": "haongo232",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/HaoNgo232/vscode-visual-html-editor"
  },
  "scripts": {
    "build:webview": "bun build src/webview/script.ts --outfile src/webview/script.js --target browser",
    "build": "bun run build:webview && bun build src/extension.ts --outdir dist --target node --external vscode",
    "test": "bun run build:webview && bun test",
    "lint": "biome check src test",
    "lint:fix": "biome check --write src test",
    "format": "biome format --write src test",
    "package": "bun run build && npx @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.75.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Visual HTML Editor",
      "properties": {
        "visualHtmlEditor.executablePath": {
          "type": "string",
          "default": "",
          "description": "Custom path to Chrome, Chromium, Edge, or Brave binary for PDF export."
        }
      }
    },
    "commands": [
      {
        "command": "visual-html-editor.open",
        "title": "Visual HTML Editor: Open Visual Editor",
        "category": "HTML"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "visual-html-editor.open",
          "when": "resourceExtname == .html",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "visual-html-editor.open",
          "when": "resourceExtname == .html",
          "group": "navigation"
        }
      ]
    }
  },
  "dependencies": {
    "@types/parse5": "^7.0.0",
    "@vscode/codicons": "^0.0.46-24",
    "parse5": "^8.0.1"
  }
}
